{
  "name": "european-alternatives",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "node scripts/install-git-hooks.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "logos:check": "node scripts/check-logo-integrity.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs --tracked",
    "secrets:scan:staged": "node scripts/scan-secrets.mjs --staged",
    "test": "vitest run --passWithNoTests",
    "db:import": "php scripts/db-import.php --source tmp/export/catalog.json",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "flag-icons": "^7.5.0",
    "framer-motion": "^12.42.0",
    "i18next": "^26.0.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@php-wasm/node": "3.1.42",
    "@php-wasm/universal": "3.1.42",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-xml-parser": "^5.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
